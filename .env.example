# Puerto del WebSocket del cliente (Nitro se conecta aquí)
HOLO_PORT=2096
HOLO_HOST=0.0.0.0

# storage: "memory" (hotel de demo, sin base de datos) o "mysql"
HOLO_STORAGE=memory

# Solo para HOLO_STORAGE=mysql
HOLO_DB_HOST=127.0.0.1
HOLO_DB_PORT=3306
HOLO_DB_USER=holo
HOLO_DB_PASSWORD=
HOLO_DB_NAME=holo

# Ticks del juego por segundo (Habbo usa 2)
HOLO_TPS=2
