{
  "name": "habbo-holo",
  "version": "0.1.0",
  "private": true,
  "description": "Habbo-style hotel emulator: binary packet protocol, rooms, pathfinding, chat and furniture.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --experimental-transform-types --watch src/index.ts",
    "start": "node --experimental-transform-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "mysql2": "3.11.5",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/ws": "8.5.13",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
